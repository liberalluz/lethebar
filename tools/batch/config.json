{
  "base": "main",
  "branch_prefix": "batch/",
  "scope": {
    "ignore": [
      "**/.godot/**",
      "**/build/**"
    ],
    "generated": [
      "**/.godot/**",
      "**/build/**"
    ]
  },
  "checks": [
    {
      "name": "tree",
      "command": [
        "python",
        "infra/checks/check_tree.py"
      ],
      "cwd": "."
    },
    {
      "name": "stage",
      "command": [
        "python",
        "infra/stage_builtin.py"
      ],
      "cwd": "."
    },
    {
      "name": "import",
      "command": [
        "godot",
        "--headless",
        "--quit"
      ],
      "cwd": "app"
    },
    {
      "name": "test",
      "command": [
        "godot",
        "--headless",
        "-s",
        "res://tests/run_tests.gd"
      ],
      "cwd": "app"
    }
  ],
  "pr_create": [],
  "merge": []
}

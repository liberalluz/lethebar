{
  "base": "main",
  "branch_prefix": "batch/",
  "scope": {
    "ignore": [
      "**/.godot/**",
      "**/build/**"
    ],
    "generated": [
      "**/.godot/**",
      "**/build/**"
    ]
  },
  "checks": [
    {
      "name": "changelog",
      "command": [
        "python",
        "infra/checks/check_changelog.py"
      ],
      "cwd": "."
    },
    {
      "name": "commit-body",
      "command": [
        "python",
        "infra/checks/check_commit_body.py"
      ],
      "cwd": "."
    },
    {
      "name": "tree",
      "command": [
        "python",
        "infra/checks/check_tree.py",
        "--profile",
        "engine"
      ],
      "cwd": "."
    },
    {
      "name": "language",
      "command": [
        "python",
        ".agents/skills/nebula-bootstrap/scripts/check_language.py",
        "--root",
        ".",
        "--strict"
      ],
      "cwd": "."
    },
    {
      "name": "stage",
      "command": [
        "python",
        "infra/stage_builtin.py"
      ],
      "cwd": "."
    },
    {
      "name": "import",
      "command": [
        "python",
        "infra/checks/run_godot.py",
        "--headless",
        "--editor",
        "--quit",
        "--path",
        "app"
      ],
      "cwd": "."
    },
    {
      "name": "test",
      "command": [
        "python",
        "infra/checks/run_godot.py",
        "--headless",
        "--path",
        "app",
        "-s",
        "res://tests/run_tests.gd"
      ],
      "cwd": "."
    },
    {
      "name": "release-tool",
      "command": [
        "python",
        "infra/tool/release/pack.py",
        "self-test"
      ],
      "cwd": "."
    },
    {
      "name": "translation",
      "command": [
        "python",
        "infra/checks/check_translation.py"
      ],
      "cwd": "."
    }
  ],
  "translate": [
    "python",
    "infra/tool/merge/translate_body.py",
    "--body",
    "{body}",
    "--locale",
    "{locale}",
    "--out",
    "{out}"
  ],
  "pr_create": [],
  "merge": []
}

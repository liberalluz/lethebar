{
  "base": "main",
  "branch_prefix": "batch/",
  "docs_root": "../lethebar-docs",
  "scope": {
    "ignore": [
      "**/.godot/**",
      "**/build/**"
    ],
    "generated": [
      "**/.godot/**",
      "**/build/**"
    ]
  },
  "commit": {
    "convention": "team",
    "types": [
      "feat",
      "fix",
      "docs",
      "test",
      "refactor",
      "chore",
      "ci"
    ],
    "scopes": [
      "app",
      "plugin",
      "content",
      "infra",
      "docs",
      "repo",
      "tools"
    ],
    "body": [
      "Why:",
      "Batch:"
    ]
  },
  "checks": [
    {
      "name": "changelog",
      "command": [
        "python",
        "infra/checks/check_changelog.py"
      ],
      "cwd": "."
    },
    {
      "name": "conventions",
      "command": [
        "python",
        "infra/checks/check_conventions.py"
      ],
      "cwd": "."
    },
    {
      "name": "commit-body",
      "command": [
        "python",
        "infra/checks/check_commit_body.py"
      ],
      "cwd": "."
    },
    {
      "name": "merge-message",
      "command": [
        "python",
        "infra/tool/merge/pr_merge.py",
        "--self-test"
      ],
      "cwd": "."
    },
    {
      "name": "badges",
      "command": [
        "python",
        "infra/tool/release/pack.py",
        "self-test"
      ],
      "cwd": "."
    },
    {
      "name": "tree",
      "command": [
        "python",
        "infra/checks/check_tree.py"
      ],
      "cwd": "."
    },
    {
      "name": "author-gate",
      "command": [
        "python",
        "infra/checks/check_author_gate.py"
      ],
      "cwd": "."
    },
    {
      "name": "language",
      "command": [
        "python",
        ".agents/skills/nebula-bootstrap/scripts/check_language.py",
        "--root",
        ".",
        "--strict"
      ],
      "cwd": "."
    },
    {
      "name": "stage",
      "command": [
        "python",
        "infra/stage_builtin.py"
      ],
      "cwd": "."
    },
    {
      "name": "lifecycle",
      "command": [
        "python",
        "infra/checks/check_lifecycle.py"
      ],
      "cwd": "."
    },
    {
      "name": "delivery",
      "command": [
        "python",
        "infra/checks/check_delivery.py",
        "--docs-root",
        "../lethebar-docs"
      ],
      "cwd": "."
    },
    {
      "name": "traceability",
      "command": [
        "python",
        "infra/checks/check_traceability.py",
        "--root",
        "."
      ],
      "cwd": "."
    },
    {
      "name": "import",
      "command": [
        "python",
        "infra/checks/run_godot.py",
        "--headless",
        "--editor",
        "--quit",
        "--path",
        "app"
      ],
      "cwd": "."
    },
    {
      "name": "test",
      "command": [
        "python",
        "infra/checks/run_godot.py",
        "--headless",
        "--path",
        "app",
        "-s",
        "res://tests/run_tests.gd"
      ],
      "cwd": "."
    },
    {
      "name": "translation",
      "command": [
        "python",
        "infra/checks/check_translation.py"
      ],
      "cwd": "."
    }
  ],
  "release_checks": [
    {
      "name": "release-tool",
      "command": [
        "python",
        "infra/tool/release/pack.py",
        "self-test"
      ],
      "cwd": "."
    },
    {
      "name": "pack-envelope",
      "command": [
        "python",
        "infra/checks/check_pack.py",
        "--self-test"
      ],
      "cwd": "."
    },
    {
      "name": "guide",
      "command": [
        "python",
        "infra/checks/check_guide.py"
      ],
      "cwd": "."
    }
  ],
  "translate": [
    "python",
    "infra/tool/merge/translate_body.py",
    "--body",
    "{body}",
    "--locale",
    "{locale}",
    "--out",
    "{out}"
  ],
  "pr_create": [],
  "merge": []
}

; Engine configuration file.
; Kept minimal on purpose: the engine shell is built in batches, not generated.

config_version=5

[application]

config/name="Lethebar"
config/description="An engine that ships no gameplay, plus plugins that carry both the story and the rules for playing it."
run/main_scene="res://render/main.tscn"

[dotnet]

project/assembly_name="lethebar"

[gui]

; The engine's own default font carries Latin glyphs only, so every Chinese
; string in a pack rendered as boxes in the browser build. One font, owned by the
; render layer, is shared by all packs: a pack carries its text, never a font.
theme/custom_font="res://render/fonts/NotoSansSC-Regular.woff2"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

; Engine configuration file.
; Kept minimal on purpose: the engine shell is built in batches, not generated.

config_version=5

[application]

config/name="Lethebar"
; The product version, and the only place it is written down. The tag, the
; release notes and the shell all read it from here, so a release does not have
; to keep three numbers in step by hand.
config/version="0.8.0"
config/description="An engine that ships no gameplay, plus plugins that carry both the story and the rules for playing it."
run/main_scene="res://render/main.tscn"

[dotnet]

project/assembly_name="lethebar"

[gui]

; The engine's own default font carries Latin glyphs only, so every Chinese
; string in a pack rendered as boxes in the browser build. One font, owned by the
; render layer, is shared by all packs: a pack carries its text, never a font.
theme/custom_font="res://render/fonts/NotoSansSC-Regular.woff2"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[display]

; A phone is held either way. The shell reflows from the window it is given
; instead of scaling a fixed canvas, so there is no stretch mode to set (B118).
window/handheld/orientation=6
window/stretch/mode="disabled"

